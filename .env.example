# คัดลอกไฟล์นี้เป็น .env แล้วใส่ค่าของคุณเอง
# ไฟล์ .env ถูก gitignore ไว้แล้ว จะไม่ถูก commit

# ---------------------------------------------------------------- ฐานข้อมูล
# ค่าเชื่อมต่อ PostgreSQL — จำเป็นต้องมี
# รูปแบบ: postgresql://ผู้ใช้:รหัสผ่าน@โฮสต์:พอร์ต/ชื่อฐานข้อมูล
#
# ถ้าติดตั้ง PostgreSQL ไว้ในเครื่องด้วยค่าเริ่มต้น ให้แก้แค่รหัสผ่าน:
DATABASE_URL=postgresql://postgres:ใส่รหัสผ่านตรงนี้@localhost:5432/line_notify

# เปิดเมื่อใช้ฐานข้อมูลบนคลาวด์ที่บังคับ TLS (Render, Supabase, Neon)
DATABASE_SSL=false

# รหัสผ่านของบัญชี admin ที่จะถูกสร้างตอน seed (ค่าเริ่มต้นคือ admin)
SEED_ADMIN_PASSWORD=admin

# ------------------------------------------------------------------- LINE
# Channel access token จาก LINE Developers Console (แท็บ Messaging API)
# ถ้าเว้นว่าง ระบบจะทำงานใน "โหมดจำลอง" — ส่งสำเร็จแบบจำลองโดยไม่ส่งจริง
# ทำให้ทดลองใช้ได้ครบทุกหน้าโดยไม่ต้องมี LINE OA
LINE_CHANNEL_ACCESS_TOKEN=

# บังคับโหมดจำลองแม้จะตั้ง token ไว้แล้ว
LINE_MOCK=false

# ------------------------------------------------------------------ Session
# กุญแจเซ็นคุกกี้ session — จำเป็นต้องมี ไม่งั้นเซิร์ฟเวอร์จะไม่สตาร์ท
# สร้างค่าสุ่มด้วย: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# ---------------------------------------------------------------- เซิร์ฟเวอร์
# ตั้งเป็น true เมื่อ deploy อยู่หลัง proxy ของ host (Render, Railway ฯลฯ)
# ถ้าไม่ตั้ง การจำกัดจำนวนครั้งล็อกอินจะนับผู้ใช้ทุกคนรวมเป็นคนเดียวกัน
# ถ้าตั้งไว้แต่ไม่ได้อยู่หลัง proxy จะถูกปลอม header เพื่อเลี่ยงการนับได้
TRUST_PROXY=false

# พอร์ตของ API — ตั้งชื่อว่า API_PORT ไม่ใช่ PORT เพื่อไม่ให้ชนกับพอร์ตของหน้าเว็บ
API_PORT=8787
